{
  // Tests are typechecked, never emitted. They live outside `rootDir: src`, so
  // they cannot join the build config without either failing loudly or leaking
  // into dist/ — hence a separate `--noEmit` program that reuses every compiler
  // option from the build config.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Tests run under Node (vitest, the generator script), so node types are
    // available here. The browser-safety guarantee is enforced by
    // `check:browser`, which compiles test/browser-entry.ts with NO tsconfig
    // and therefore no node types.
    "types": ["node"]
  },
  "include": ["src", "test"]
}
