{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  // `vectors-node.ts` is the package's ONLY Node-only module. Excluding it
  // here is what makes the main build browser-safe by construction: if any
  // other src file starts importing a `node:*` builtin, this build fails.
  // It is compiled separately by tsconfig.node.json into the same dist/.
  "include": ["src"],
  "exclude": ["src/vectors-node.ts"]
}
