{
  "name": "@menhir/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors": {
      "types": "./dist/vectors-node.d.ts",
      "import": "./dist/vectors-node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "generate:vectors": "tsx test/generate-vectors.ts",
    "check:browser": "tsc --noEmit --ignoreConfig --lib es2022,dom --strict --module esnext --moduleResolution bundler --skipLibCheck test/browser-entry.ts"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "multiformats": "14.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "tsx": "4.23.1",
    "@types/node": "26.6.5"
  }
}