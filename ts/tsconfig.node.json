{
  // Node-only entry points (`@menhir/core/vectors`). Kept as a separate
  // program so the main build (`tsconfig.json`, browser-safe) never needs
  // @types/node — that separation is what enforces core-ts design §1: no
  // Node builtins reachable from the package root.
  //
  // moduleResolution must be NodeNext here: with `bundler`, TS 7 does not
  // resolve the `node:` specifiers to @types/node (observed: TS2591).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/vectors.ts", "src/vectors-node.ts", "src/commitment.ts", "src/canon.ts", "src/errors.ts"],
  // MANDATORY: `include` cannot override an inherited `exclude`, and the base
  // config excludes `src/vectors-node.ts` to keep the root export browser-safe.
  // Without this empty exclude the Node program silently drops the very file
  // it exists to compile — the build "succeeds" and emits no vectors-node.js,
  // so a clean consumer gets ERR_MODULE_NOT_FOUND at runtime. Verified by a
  // clean-room build: empty dist/ of vectors-node before, present after.
  "exclude": []
}
