{
  "name": "@menhir/contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "typecheck": "hardhat build && tsc -p tsconfig.json --noEmit",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "seed:sepolia": "hardhat run scripts/seed.ts --network baseSepolia",
    "gas:snapshot": "hardhat test --gas-stats-json gas-snapshot.json",
    "verify:blockscout": "hardhat verify blockscout --network baseSepolia 0xC85ed11d3065739F1829A114e420584bEC3FDFEF",
    "verify:sourcify": "hardhat verify sourcify --network baseSepolia 0xC85ed11d3065739F1829A114e420584bEC3FDFEF",
    "verify:local": "hardhat run scripts/verify-local.ts --network baseSepolia"
  },
  "dependencies": {
    "@menhir/core": "workspace:*",
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "hardhat": "3.20.0",
    "typescript": "7.0.2",
    "viem": "2.57.7"
  }
}